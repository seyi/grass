# GRASS GIS MCP Server - Environment Variables Template
# Copy this file to .env and fill in your local development values.
# DO NOT commit the .env file - it contains sensitive credentials.

# GRASS GIS Configuration
GISBASE=/usr/lib/grass83
GRASS_BINARY=/usr/lib/grass83/bin/grass

# Server Configuration
SERVER_PORT=3000
LOG_LEVEL=INFO

# Optional: API Keys (if integrating with external services)
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here

# Optional: Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/grassdb

# Optional: Monitoring
# DATADOG_API_KEY=your_key_here
# SENTRY_DSN=your_dsn_here
